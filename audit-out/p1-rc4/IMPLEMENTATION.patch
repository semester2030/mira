+function assertRc4Db(url) {
+  const u = new URL(url);
+  const host = u.hostname;
+  const db = u.pathname.replace(/^\//, '').split('?')[0];
+  if (host !== 'localhost' && host !== '127.0.0.1') throw new Error(`REFUSE host ${host}`);
+  if (db !== 'mira_p1_rc4_test') throw new Error(`REFUSE db ${db}`);
+  return { host, db };
+}
