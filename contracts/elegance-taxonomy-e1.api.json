{
  "schemaVersion": 1,
  "lane": "elegance",
  "phase": "E1",
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/marketplace/taxonomy",
      "auth": "none",
      "query": { "lane": "elegance (required for this projection; other lanes 400)" },
      "response": {
        "schemaVersion": "number",
        "lane": "elegance",
        "definitionsVersion": "number",
        "compatMinAppBuild": "number",
        "nodes": [
          {
            "id": "string",
            "parentId": "string|null",
            "labelAr": "string",
            "sort": "number",
            "active": "boolean",
            "browseOnly": "boolean",
            "writeEnabled": "boolean",
            "imageKey": "string|null",
            "profileId": "string|null",
            "children": ["string"]
          }
        ]
      },
      "notes": "Derived from mira-api/src/marketplace/taxonomy/elegance-taxonomy.v1.json. No partner session. No internal paths."
    },
    {
      "method": "GET",
      "path": "/api/v1/marketplace/catalog",
      "auth": "none",
      "queryAdded": { "subcategory": "exact persisted node id; applied before pagination" },
      "productItemAdded": ["subcategory", "profileId"]
    },
    {
      "method": "POST",
      "path": "/api/v1/partners-portal/products",
      "auth": "partner Bearer",
      "bodyAdded": ["subcategory", "profileId", "attributes"],
      "validation": "TaxonomyService.validateWrite — fieldErrors on 400"
    },
    {
      "method": "PATCH",
      "path": "/api/v1/partners-portal/products/:id",
      "auth": "partner Bearer",
      "bodyAdded": ["subcategory", "profileId", "attributes"],
      "compat": "omitted subcategory does not clear existing"
    }
  ],
  "storage": {
    "products.subcategory": "TEXT nullable",
    "products.attributes_json": "JSONB nullable",
    "products.draft_category": "TEXT nullable (published pending)",
    "products.draft_subcategory": "TEXT nullable",
    "products.draft_profile_id": "TEXT nullable",
    "products.draft_attributes_json": "JSONB nullable",
    "products.draft_taxonomy_set": "BOOLEAN default false",
    "migrations": [
      "20261107210000_elegance_e1_product_subcategory",
      "20261107223000_elegance_e1_draft_taxonomy"
    ],
    "rollbackPreferred": "Redeploy prior app build; leave additive columns. DROP only on unused environments with no dependent writes."
  },
  "patchContract": {
    "attributesEmptyObject": "keep existing",
    "attributesNullBag": "400 ATTRIBUTES_NULL_FORBIDDEN",
    "attributesKeyNull": "clears that key",
    "nestedNull": "400 (DIMENSIONS_NULL for dimensionsCm.*)",
    "arrayReplace": "whole unit",
    "publishedTaxonomy": "writes draft_* until approve"
  }
}
