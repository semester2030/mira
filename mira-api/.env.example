NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# With Docker: docker compose up -d
DATABASE_URL=postgresql://mira:mira_secret@localhost:5432/mira_db?schema=public

# Without Docker (Homebrew Postgres): run `npm run db:setup` first
# DATABASE_URL=postgresql://mira:mira_secret@localhost:5432/mira_db?schema=public

# Redis optional — API works without it (rate limit skipped)
REDIS_URL=redis://localhost:6379

# mock | perfect_corp (YouCam S2S — production on Render)
SKIN_PROVIDER=perfect_corp
# mock | fashn
OUTFIT_PROVIDER=mock

# YouCam API key (server only — never in Flutter): https://yce.makeupar.com/api-console/en/api-keys/
# Render Dashboard: PERFECT_API_KEY + PERFECT_BASE_URL (aliases below also work)
PERFECT_API_KEY=
PERFECT_BASE_URL=https://yce-api-01.makeupar.com/s2s/v2.0
PERFECT_CORP_API_KEY=
PERFECT_CORP_BASE_URL=https://yce-api-01.makeupar.com/s2s/v2.0
# Comma-separated SD concerns (do not mix HD + SD)
PERFECT_CORP_DST_ACTIONS=wrinkle,pore,texture,acne,moisture,oiliness,redness,age_spot
PERFECT_CORP_POLL_INTERVAL_MS=1500
PERFECT_CORP_POLL_MAX_MS=90000
# Set false in production so failures surface instead of silent mock
PERFECT_CORP_FALLBACK_MOCK=true
# Face gate: Flutter ML Kit (client) + server photo checks + YouCam no-face errors

# Vision Platform — server-side only (never in Flutter)
# FASHN geometry (Phase 3) + segmentation (Phase 8)
FASHN_API_KEY=
FASHN_BASE_URL=
# Legacy OUTFIT_PROVIDER path (compatibilityScore — not Vision Platform)
FASHN_ENDPOINT=/v1/outfit-analysis
# Vision Platform Phase 3 — geometry only (segmentation)
FASHN_GEOMETRY_ENDPOINT=/v1/segmentation
FASHN_API_KEY_HEADER=Authorization
FASHN_API_KEY_PREFIX=Bearer 
FASHN_TIMEOUT_MS=20000


# Legacy outfit-intelligence endpoint (Vision Platform + LLM — server only)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=45000

# Firebase Admin (JSON string or path via GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_PROJECT_ID=
# Set true only for local testing without Firebase
AUTH_SKIP=false

# Max analyses per hour per user (Redis)
RATE_LIMIT_PER_HOUR=30

# Comma-separated origins for public website (CORS)
WEBSITE_CORS_ORIGINS=http://localhost:8080,https://mira-website.onrender.com

# Partner portal + Admin panel — header X-Admin-Key
ADMIN_API_KEY=
# Set true in dev to auto-approve applications on submit
PARTNER_AUTO_APPROVE=false

# Admin portal CORS — add https://mira-admin-portal.onrender.com

# Free tier: 3 skin + 3 outfit analyses per month (see subscription-plans.ts)
# RevenueCat webhook: POST /api/v1/subscriptions/webhook
