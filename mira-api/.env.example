NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# With Docker: docker compose up -d
DATABASE_URL=postgresql://mira:mira_secret@localhost:5432/mira_db?schema=public

# Without Docker (Homebrew Postgres): run `npm run db:setup` first
# DATABASE_URL=postgresql://mira:mira_secret@localhost:5432/mira_db?schema=public

# Redis optional — API works without it (rate limit skipped)
REDIS_URL=redis://localhost:6379

# mock | perfect_corp
SKIN_PROVIDER=mock
# mock | fashn
OUTFIT_PROVIDER=mock

PERFECT_CORP_API_KEY=
FASHN_API_KEY=

# Firebase Admin (JSON string or path via GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_PROJECT_ID=
# Set true only for local testing without Firebase
AUTH_SKIP=false

# Max analyses per hour per user (Redis)
RATE_LIMIT_PER_HOUR=30

# Free tier: 3 skin + 3 outfit analyses per month (see subscription-plans.ts)
# RevenueCat webhook: POST /api/v1/subscriptions/webhook
