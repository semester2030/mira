{
  "name": "mira-api",
  "version": "1.0.0",
  "description": "Mira backend API — skin, outfit, and unified recommendations",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "render:build": "prisma generate && npm run build",
    "render:start": "prisma migrate deploy && npm run start:prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "db:setup": "bash scripts/setup-local-db.sh",
    "stop": "bash scripts/stop-port.sh",
    "dev": "bash scripts/stop-port.sh && bash scripts/dev.sh",
    "test:vision-schema": "npm run build && node dist/vision/schema/fashion-vision-document.schema-tests.js",
    "test:vision-geometry": "npm run build && node dist/vision/providers/fashn-geometry.schema-tests.js",
    "test:vision-semantic": "npm run build && node dist/vision/providers/openai-semantic.schema-tests.js",
    "test:vision-pipeline": "npm run build && node dist/vision/pipeline/vision-pipeline.schema-tests.js",
    "test:vision-conflicts": "npm run build && node dist/vision/pipeline/conflict-confidence.schema-tests.js",
    "test:vision-topology": "npm run build && node dist/vision/pipeline/topology-resolver.schema-tests.js",
    "test:qel-calibration": "npm run build && node dist/vision/qel/qel-calibration.runner.js",
    "test:qel-calibration:smoke": "npm run build && QEL_CALIBRATION_DATASET=src/vision/qel/fixtures/qel-evaluation-manifest.smoke.json node dist/vision/qel/qel-calibration.runner.js",
    "sync:colors": "cd .. && python3 scripts/generate_fashion_colors.py && dart run scripts/sync_fashion_catalog.dart"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^13.0.0",
    "ioredis": "^5.4.0",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
