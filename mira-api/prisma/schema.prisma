generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String?
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  skinAnalyses    SkinAnalysis[]
  outfitAnalyses  OutfitAnalysis[]
  recommendations Recommendation[]
  subscription    Subscription?
  preference      UserPreference?
  feedback        Feedback[]
  auditLogs       AuditLog[]
  consultationSessions ConsultationSession[]
  atelierRecolorAttempts AtelierRecolorAttempt[]

  @@map("users")
}

model SkinAnalysis {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultJson Json     @map("result_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("skin_analyses")
}

model OutfitAnalysis {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occasionId String   @map("occasion_id")
  resultJson Json     @map("result_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("outfit_analyses")
}

model Recommendation {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultJson Json     @map("result_json")
  occasionId String?  @map("occasion_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("recommendations")
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             String    @default("free")
  status           String    @default("active")
  externalId       String?   @map("external_id")
  currentPeriodEnd DateTime? @map("current_period_end")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale          String   @default("ar")
  birthYear       Int?     @map("birth_year")
  stylePrefsJson  Json?    @map("style_prefs_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    String
  rating    Int?
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedback")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// B2B partner — brand, clinic, or salon (v1 catalog + matching).
model Partner {
  id            String   @id @default(uuid())
  type          String   // brand | clinic | salon
  status        String   @default("active") // pending | active | suspended
  nameAr        String   @map("name_ar")
  nameEn        String   @map("name_en")
  descriptionAr String?  @map("description_ar")
  city          String   @default("الرياض")
  logoEmoji     String?  @map("logo_emoji")
  storeUrl      String?  @map("store_url")
  rating        Float    @default(4.5)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  products Product[]
  services Service[]
  applications PartnerApplication[]
  users      PartnerUser[]
  events     PartnerEvent[]

  @@index([type, status])
  @@map("partners")
}

model Product {
  id            String   @id @default(uuid())
  partnerId     String   @map("partner_id")
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  nameAr        String   @map("name_ar")
  nameEn        String   @map("name_en")
  descriptionAr String?  @map("description_ar")
  priceHalalas  Int      @map("price_halalas")
  externalUrl   String   @map("external_url")
  concernTags   String[] @map("concern_tags")
  skinTypes     String[] @map("skin_types")
  stepAr        String?  @map("step_ar")
  sortOrder     Int      @default(0) @map("sort_order")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([partnerId, active])
  @@map("products")
}

model Service {
  id              String   @id @default(uuid())
  partnerId       String   @map("partner_id")
  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  nameAr          String   @map("name_ar")
  nameEn          String   @map("name_en")
  descriptionAr   String?  @map("description_ar")
  durationMin     Int      @map("duration_min")
  priceHalalas    Int      @map("price_halalas")
  concernTags     String[] @map("concern_tags")
  bookingEnabled  Boolean  @default(false) @map("booking_enabled")
  sortOrder       Int      @default(0) @map("sort_order")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([partnerId, active])
  @@map("services")
}

/// Public website contact / partnership leads (no auth).
model WebsiteLead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  type      String   @default("contact") // contact | partnership | media | support
  message   String
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("website_leads")
}

/// Partner onboarding request — auto workflow to Partner on approve.
model PartnerApplication {
  id            String    @id @default(uuid())
  status        String    @default("pending") // pending | approved | rejected
  type          String    // brand | clinic | salon
  nameAr        String    @map("name_ar")
  nameEn        String    @map("name_en")
  contactName   String    @map("contact_name")
  contactEmail  String    @map("contact_email")
  contactPhone  String    @map("contact_phone")
  city          String    @default("الرياض")
  descriptionAr String?   @map("description_ar")
  storeUrl      String?   @map("store_url")
  crNumber      String?   @map("cr_number")
  vatNumber     String?   @map("vat_number")
  message       String?
  statusToken   String    @unique @map("status_token")
  partnerId     String?   @map("partner_id")
  rejectReason  String?   @map("reject_reason")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  partner Partner? @relation(fields: [partnerId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@map("partner_applications")
}

/// Partner portal login — one owner per partner (v1).
model PartnerUser {
  id          String   @id @default(uuid())
  partnerId   String   @unique @map("partner_id")
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  email       String   @unique
  accessToken String   @unique @map("access_token")
  role        String   @default("owner")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("partner_users")
}

/// Aggregated partner analytics (no user PII).
model PartnerEvent {
  id        String   @id @default(uuid())
  partnerId String   @map("partner_id")
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  eventType String   @map("event_type") // impression | click | booking_request
  targetId  String?  @map("target_id")
  targetType String? @map("target_type") // product | service
  createdAt DateTime @default(now()) @map("created_at")

  @@index([partnerId, eventType, createdAt(sort: Desc)])
  @@map("partner_events")
}

/// MCE — consultation session (reference: docs/mira-vision-platform.html#mce-consultation)
model ConsultationSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleAr          String?  @map("title_ar")
  status           String   @default("active")
  locale           String   @default("ar")
  occasionId       String?  @map("occasion_id")
  activeSnapshotId String?  @map("active_snapshot_id")
  rollingSummaryAr String?  @map("rolling_summary_ar") @db.Text
  turnCount        Int      @default(0) @map("turn_count")
  lastCompactedAt  DateTime? @map("last_compacted_at")
  planTier         String   @default("free") @map("plan_tier")
  metadataJson     Json?    @map("metadata_json")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  messages       ConsultationMessage[]
  snapshots      ConsultationContextSnapshot[]
  recommendations ConsultationRecommendation[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, status])
  @@map("consultation_sessions")
}

model ConsultationMessage {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  session      ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         String
  contentAr    String   @map("content_ar") @db.Text
  payloadJson  Json?    @map("payload_json")
  tokenCountIn  Int?    @map("token_count_in")
  tokenCountOut Int?    @map("token_count_out")
  modelId      String?  @map("model_id")
  latencyMs    Int?     @map("latency_ms")
  blocked      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("consultation_messages")
}

model ConsultationContextSnapshot {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  session          ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  version          Int
  skinAnalysisId   String?  @map("skin_analysis_id")
  outfitAnalysisId String?  @map("outfit_analysis_id")
  recolorAttemptId String?  @map("recolor_attempt_id")
  snapshotJson     Json     @map("snapshot_json")
  factRegistryJson Json     @map("fact_registry_json")
  contentHash      String   @map("content_hash")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([sessionId, version])
  @@index([skinAnalysisId])
  @@index([outfitAnalysisId])
  @@map("consultation_context_snapshots")
}

model ConsultationRecommendation {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  session     ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId   String?  @map("message_id")
  type        String
  titleAr     String   @map("title_ar")
  rationaleAr String   @map("rationale_ar") @db.Text
  confidence  String
  partnerId   String?  @map("partner_id")
  productId   String?  @map("product_id")
  metadataJson Json?   @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("consultation_recommendations")
}

/// MCE Phase 4 — Atelier QEL recolor attempts (no image stored).
model AtelierRecolorAttempt {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitAnalysisId String?  @map("outfit_analysis_id")
  garmentLabelAr   String   @map("garment_label_ar")
  targetColorAr    String   @map("target_color_ar")
  targetColorHex   String?  @map("target_color_hex")
  regionRole       String?  @map("region_role")
  qelGate          String   @map("qel_gate")
  qelScoresJson    Json?    @map("qel_scores_json")
  rejectReasonAr   String?  @map("reject_reason_ar") @db.Text
  recolorScope     String   @default("color_only") @map("recolor_scope")
  processingMs     Int?     @map("processing_ms")
  attemptNumber    Int      @default(1) @map("attempt_number")
  metadataJson     Json?    @map("metadata_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("atelier_recolor_attempts")
}
