generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String?
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  skinAnalyses    SkinAnalysis[]
  outfitAnalyses  OutfitAnalysis[]
  recommendations Recommendation[]
  subscription    Subscription?
  preference      UserPreference?
  feedback        Feedback[]
  auditLogs       AuditLog[]
  consultationSessions ConsultationSession[]
  atelierRecolorAttempts AtelierRecolorAttempt[]
  catalogFavorites CatalogFavorite[]
  commerceCart     CommerceCart?
  commerceOrders   CommerceOrder[]
  commerceBookings CommerceBooking[]

  @@map("users")
}

model SkinAnalysis {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultJson Json     @map("result_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("skin_analyses")
}

model OutfitAnalysis {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occasionId String   @map("occasion_id")
  resultJson Json     @map("result_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("outfit_analyses")
}

model Recommendation {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultJson Json     @map("result_json")
  occasionId String?  @map("occasion_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("recommendations")
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             String    @default("free")
  status           String    @default("active")
  externalId       String?   @map("external_id")
  currentPeriodEnd DateTime? @map("current_period_end")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale          String   @default("ar")
  birthYear       Int?     @map("birth_year")
  stylePrefsJson  Json?    @map("style_prefs_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    String
  rating    Int?
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedback")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// B2B partner — brand, clinic, or salon (v1 catalog + matching).
model Partner {
  id            String   @id @default(uuid())
  type          String   // brand | clinic | salon
  status        String   @default("active") // pending | active | suspended
  nameAr        String   @map("name_ar")
  nameEn        String   @map("name_en")
  descriptionAr String?  @map("description_ar")
  city          String   @default("الرياض")
  logoEmoji     String?  @map("logo_emoji")
  storeUrl      String?  @map("store_url")
  contactPhone  String?  @map("contact_phone")
  rating        Float    @default(4.5)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  products Product[]
  services Service[]
  applications PartnerApplication[]
  users      PartnerUser[]
  events     PartnerEvent[]
  sourceLinks CatalogSourceLink[]
  advertisedAds CatalogAd[] @relation("AdAdvertiser")
  publishedAds  CatalogAd[] @relation("AdPublisher")
  commerceCarts    CommerceCart[]
  commerceOrders   CommerceOrder[]
  commerceBookings CommerceBooking[]

  @@index([type, status])
  @@map("partners")
}

model Product {
  id            String   @id @default(uuid())
  partnerId     String   @map("partner_id")
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  nameAr        String   @map("name_ar")
  nameEn        String   @map("name_en")
  descriptionAr String?  @map("description_ar")
  priceHalalas  Int      @map("price_halalas")
  externalUrl   String   @map("external_url")
  concernTags   String[] @map("concern_tags")
  category      String?
  skinTypes     String[] @map("skin_types")
  stepAr        String?  @map("step_ar")
  sortOrder     Int      @default(0) @map("sort_order")
  active        Boolean  @default(true)
  contentStatus String   @default("published") @map("content_status")
  reviewNote    String?  @map("review_note")
  draftNameAr   String?  @map("draft_name_ar")
  draftNameEn   String?  @map("draft_name_en")
  draftDescriptionAr String? @map("draft_description_ar")
  submittedAt   DateTime? @map("submitted_at")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewedBy    String?  @map("reviewed_by")
  reviewStatus  String   @default("none") @map("review_status")
  reviewRevision Int     @default(0) @map("review_revision")
  submittedRevision Int? @map("submitted_revision")
  catalogSource String   @default("catalog") @map("catalog_source")
  /// external = open externalUrl (not a purchase) | internal_cod = in-Mira cart/order + cash on delivery
  purchaseMode  String   @default("external") @map("purchase_mode")
  /// null = unlimited / untracked
  stockQty      Int?     @map("stock_qty")
  reservedQty   Int      @default(0) @map("reserved_qty")
  optionsJson   Json?    @map("options_json")
  variantsJson  Json?    @map("variants_json")
  /// Pending options/variants for published rows — applied on content approve only.
  draftOptionsJson  Json? @map("draft_options_json")
  draftVariantsJson Json? @map("draft_variants_json")
  /// True when a published-row options draft is pending (including an explicit clear).
  draftOptionsSet   Boolean @default(false) @map("draft_options_set")
  draftVariantsSet  Boolean @default(false) @map("draft_variants_set")
  /// null = fee unknown (NOT free)
  deliveryFeeHalalas Int? @map("delivery_fee_halalas")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([partnerId, active])
  @@map("products")
}

model Service {
  id              String   @id @default(uuid())
  partnerId       String   @map("partner_id")
  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  nameAr          String   @map("name_ar")
  nameEn          String   @map("name_en")
  descriptionAr   String?  @map("description_ar")
  durationMin     Int      @map("duration_min")
  priceHalalas    Int      @map("price_halalas")
  concernTags     String[] @map("concern_tags")
  category        String?
  bookingEnabled  Boolean  @default(false) @map("booking_enabled")
  sortOrder       Int      @default(0) @map("sort_order")
  active          Boolean  @default(true)
  contentStatus   String   @default("published") @map("content_status")
  reviewNote      String?  @map("review_note")
  draftNameAr     String?  @map("draft_name_ar")
  draftNameEn     String?  @map("draft_name_en")
  draftDescriptionAr String? @map("draft_description_ar")
  submittedAt     DateTime? @map("submitted_at")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedBy      String?  @map("reviewed_by")
  reviewStatus    String   @default("none") @map("review_status")
  reviewRevision  Int      @default(0) @map("review_revision")
  submittedRevision Int?   @map("submitted_revision")
  catalogSource   String   @default("catalog") @map("catalog_source")
  payMode         String   @default("pay_at_venue") @map("pay_mode")
  /// [{ weekday: 0-6 (0=Sunday), startMin, endMin, capacity }]
  availabilityJson Json?   @map("availability_json")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([partnerId, active])
  @@map("services")
}

/// Public website contact / partnership leads (no auth).
model WebsiteLead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  type      String   @default("contact") // contact | partnership | media | support
  message   String
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("website_leads")
}

/// Partner onboarding request — auto workflow to Partner on approve.
model PartnerApplication {
  id            String    @id @default(uuid())
  status        String    @default("pending") // pending | approved | rejected
  type          String    // brand | clinic | salon
  nameAr        String    @map("name_ar")
  nameEn        String    @map("name_en")
  contactName   String    @map("contact_name")
  contactEmail  String    @map("contact_email")
  contactPhone  String    @map("contact_phone")
  city          String    @default("الرياض")
  descriptionAr String?   @map("description_ar")
  storeUrl      String?   @map("store_url")
  crNumber      String?   @map("cr_number")
  vatNumber     String?   @map("vat_number")
  message       String?
  statusToken   String    @unique @map("status_token")
  partnerId     String?   @map("partner_id")
  rejectReason  String?   @map("reject_reason")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  partner Partner? @relation(fields: [partnerId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@map("partner_applications")
}

/// Partner portal login — one owner per partner (v1).
model PartnerUser {
  id          String   @id @default(uuid())
  partnerId   String   @unique @map("partner_id")
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  email       String   @unique
  accessToken String   @unique @map("access_token")
  role        String   @default("owner")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("partner_users")
}

/// Aggregated partner analytics (no user PII).
model PartnerEvent {
  id        String   @id @default(uuid())
  partnerId String   @map("partner_id")
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  eventType String   @map("event_type") // impression | click | booking_request
  targetId  String?  @map("target_id")
  targetType String? @map("target_type") // product | service
  createdAt DateTime @default(now()) @map("created_at")

  @@index([partnerId, eventType, createdAt(sort: Desc)])
  @@map("partner_events")
}

/// Published media for an existing product or service. It does not store price or stock.
model CatalogMedia {
  id        String   @id @default(uuid())
  ownerKind String   @map("owner_kind")
  ownerId   String   @map("owner_id")
  sortOrder Int      @default(0) @map("sort_order")
  kind      String
  url         String
  active      Boolean  @default(true)
  mimeType    String?  @map("mime_type")
  byteSize    Int?     @map("byte_size")
  storageKey  String?  @map("storage_key")
  isPrimary      Boolean  @default(false) @map("is_primary")
  publication    String   @default("published")
  pendingRemoval Boolean  @default(false) @map("pending_removal")
  draftSortOrder Int?     @map("draft_sort_order")
  draftIsPrimary Boolean? @map("draft_is_primary")
  sourceMediaKey String?  @map("source_media_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([ownerKind, ownerId, sourceMediaKey])
  @@index([ownerKind, ownerId, sortOrder])
  @@map("catalog_media")
}

/// Celebrity ad. Price, stock, and ownership stay on the linked product or service.
model CatalogAd {
  id                  String   @id @default(uuid())
  targetKind          String   @map("target_kind")
  targetId            String   @map("target_id")
  advertiserPartnerId String   @map("advertiser_partner_id")
  advertiser          Partner  @relation("AdAdvertiser", fields: [advertiserPartnerId], references: [id])
  publisherPartnerId  String   @map("publisher_partner_id")
  publisher           Partner  @relation("AdPublisher", fields: [publisherPartnerId], references: [id])
  captionAr           String?  @map("caption_ar")
  status              String   @default("draft")
  reviewRevision      Int      @default(0) @map("review_revision")
  submittedRevision   Int?     @map("submitted_revision")
  reviewNote          String?  @map("review_note")
  reviewedBy          String?  @map("reviewed_by")
  submittedAt         DateTime? @map("submitted_at")
  createdAt           DateTime @default(now()) @map("created_at")
  actions             CatalogAdAction[]
  decisions           CatalogAdDecision[]

  @@index([targetKind, targetId, status])
  @@index([advertiserPartnerId, status])
  @@map("catalog_ads")
}

/// An admin decision for one ad revision. The actor is the admin API identity, not a person's name.
model CatalogAdDecision {
  id        String    @id @default(uuid())
  adId      String    @map("ad_id")
  ad        CatalogAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  revision  Int
  decision  String
  actor     String
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([adId, createdAt])
  @@map("catalog_ad_decisions")
}

/// A link open on an ad. It is not a qualified view and not a completed purchase.
model CatalogAdAction {
  id        String    @id @default(uuid())
  eventId   String    @unique @map("event_id")
  adId      String    @map("ad_id")
  ad        CatalogAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([adId, action])
  @@map("catalog_ad_actions")
}

/// Account-scoped catalog favorite. Rows are readable only for their user.
model CatalogFavorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerKind String   @map("owner_kind")
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, ownerKind, ownerId])
  @@index([userId])
  @@map("catalog_favorites")
}

/// Links an existing product or service to an external source id. It is not a second catalog.
model CatalogSourceLink {
  id           String    @id @default(uuid())
  partnerId    String    @map("partner_id")
  partner      Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  ownerKind    String    @map("owner_kind")
  ownerId      String    @map("owner_id")
  source       String
  externalId   String    @map("external_id")
  miraNoteAr   String?   @map("mira_note_ar")
  lastSyncedAt DateTime? @map("last_synced_at")

  @@unique([partnerId, source, externalId])
  @@map("catalog_source_links")
}

model CatalogReviewLog {
  id        String   @id @default(uuid())
  ownerKind String   @map("owner_kind")
  ownerId   String   @map("owner_id")
  actor     String
  action    String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerKind, ownerId, createdAt])
  @@map("catalog_review_logs")
}

/// MCE — consultation session (reference: docs/mira-vision-platform.html#mce-consultation)
model ConsultationSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleAr          String?  @map("title_ar")
  status           String   @default("active")
  locale           String   @default("ar")
  occasionId       String?  @map("occasion_id")
  activeSnapshotId String?  @map("active_snapshot_id")
  rollingSummaryAr String?  @map("rolling_summary_ar") @db.Text
  turnCount        Int      @default(0) @map("turn_count")
  lastCompactedAt  DateTime? @map("last_compacted_at")
  planTier         String   @default("free") @map("plan_tier")
  metadataJson     Json?    @map("metadata_json")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  messages       ConsultationMessage[]
  snapshots      ConsultationContextSnapshot[]
  recommendations ConsultationRecommendation[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, status])
  @@map("consultation_sessions")
}

model ConsultationMessage {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  session      ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         String
  contentAr    String   @map("content_ar") @db.Text
  payloadJson  Json?    @map("payload_json")
  tokenCountIn  Int?    @map("token_count_in")
  tokenCountOut Int?    @map("token_count_out")
  modelId      String?  @map("model_id")
  latencyMs    Int?     @map("latency_ms")
  blocked      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("consultation_messages")
}

model ConsultationContextSnapshot {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  session          ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  version          Int
  skinAnalysisId   String?  @map("skin_analysis_id")
  outfitAnalysisId String?  @map("outfit_analysis_id")
  recolorAttemptId String?  @map("recolor_attempt_id")
  snapshotJson     Json     @map("snapshot_json")
  factRegistryJson Json     @map("fact_registry_json")
  contentHash      String   @map("content_hash")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([sessionId, version])
  @@index([skinAnalysisId])
  @@index([outfitAnalysisId])
  @@map("consultation_context_snapshots")
}

model ConsultationRecommendation {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  session     ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId   String?  @map("message_id")
  type        String
  titleAr     String   @map("title_ar")
  rationaleAr String   @map("rationale_ar") @db.Text
  confidence  String
  partnerId   String?  @map("partner_id")
  productId   String?  @map("product_id")
  metadataJson Json?   @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("consultation_recommendations")
}

/// MCE Phase 4 — Atelier QEL recolor attempts (no image stored).
model AtelierRecolorAttempt {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitAnalysisId String?  @map("outfit_analysis_id")
  garmentLabelAr   String   @map("garment_label_ar")
  targetColorAr    String   @map("target_color_ar")
  targetColorHex   String?  @map("target_color_hex")
  regionRole       String?  @map("region_role")
  qelGate          String   @map("qel_gate")
  qelScoresJson    Json?    @map("qel_scores_json")
  rejectReasonAr   String?  @map("reject_reason_ar") @db.Text
  recolorScope     String   @default("color_only") @map("recolor_scope")
  processingMs     Int?     @map("processing_ms")
  attemptNumber    Int      @default(1) @map("attempt_number")
  metadataJson     Json?    @map("metadata_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("atelier_recolor_attempts")
}

/// One open cart per user. A cart belongs to a single partner.
model CommerceCart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerId String?  @map("partner_id")
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt @map("updated_at")

  items CommerceCartItem[]

  @@map("commerce_carts")
}

model CommerceCartItem {
  id             String       @id @default(uuid())
  cartId         String       @map("cart_id")
  cart           CommerceCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String       @map("product_id")
  variantKey     String       @default("") @map("variant_key")
  selectionsJson Json?        @map("selections_json")
  quantity       Int
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([cartId, productId, variantKey])
  @@map("commerce_cart_items")
}

/// Cash-on-delivery order. fulfillmentStatus, deliveryStatus and paymentCollectionStatus are independent axes.
model CommerceOrder {
  id           String  @id @default(uuid())
  publicNumber String  @unique @map("public_number")
  userId       String  @map("user_id")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerId    String  @map("partner_id")
  partner      Partner @relation(fields: [partnerId], references: [id])

  /// new | accepted | preparing | out_for_delivery | delivered | rejected | cancelled | failed_delivery
  fulfillmentStatus       String    @default("new") @map("fulfillment_status")
  /// pending | out_for_delivery | delivered | failed | none
  deliveryStatus          String    @default("pending") @map("delivery_status")
  /// cod
  paymentMethod           String    @default("cod") @map("payment_method")
  /// uncollected | collected | waived
  paymentCollectionStatus String    @default("uncollected") @map("payment_collection_status")
  collectionActor         String?   @map("collection_actor")
  collectedAt             DateTime? @map("collected_at")

  subtotalHalalas    Int    @map("subtotal_halalas")
  /// null = delivery fee unknown at order time
  deliveryFeeHalalas Int?   @map("delivery_fee_halalas")
  totalHalalas       Int    @map("total_halalas")
  currency           String @default("SAR")

  contactName  String  @map("contact_name")
  contactPhone String  @map("contact_phone")
  addressLine  String  @map("address_line")
  city         String
  notes        String?

  idempotencyKey  String?  @map("idempotency_key")
  /// Hash of the normalized create attempt (delivery + confirmed cart). Used for IDEMPOTENCY_CONFLICT.
  requestFingerprint String? @map("request_fingerprint")
  clientRequestId String?  @map("client_request_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  items  CommerceOrderItem[]
  events CommerceOrderEvent[]

  @@unique([userId, idempotencyKey])
  @@index([partnerId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("commerce_orders")
}

model CommerceOrderItem {
  id               String        @id @default(uuid())
  orderId          String        @map("order_id")
  order            CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String        @map("product_id")
  productNameAr    String        @map("product_name_ar")
  variantKey       String        @default("") @map("variant_key")
  selectionsJson   Json?         @map("selections_json")
  unitPriceHalalas Int           @map("unit_price_halalas")
  quantity         Int
  lineTotalHalalas Int           @map("line_total_halalas")
  /// Units held against Product.reservedQty at order create (0 when stock is untracked).
  reservedQty      Int           @default(0) @map("reserved_qty")
  /// none | reserved | released | consumed — guards against double release.
  stockState       String        @default("none") @map("stock_state")

  @@index([orderId])
  @@map("commerce_order_items")
}

model CommerceOrderEvent {
  id         String        @id @default(uuid())
  orderId    String        @map("order_id")
  order      CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// customer | partner | admin | system
  actorType  String        @map("actor_type")
  actorId    String?       @map("actor_id")
  fromStatus String?       @map("from_status")
  toStatus   String?       @map("to_status")
  /// fulfillment | delivery | payment | note
  field      String
  note       String?
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("commerce_order_events")
}

/// Independent service booking. Customer pays at the venue; Mira does not collect.
model CommerceBooking {
  id             String   @id @default(uuid())
  publicNumber   String   @unique @map("public_number")
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerId      String   @map("partner_id")
  partner        Partner  @relation(fields: [partnerId], references: [id])
  serviceId      String   @map("service_id")
  serviceNameAr  String   @map("service_name_ar")
  branchLabel    String?  @map("branch_label")
  /// Empty string = legacy / no explicit resource. Same resource across services shares capacity.
  resourceId     String   @default("") @map("resource_id")
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  durationMin    Int      @map("duration_min")
  priceHalalas   Int      @map("price_halalas")
  payMode        String   @default("pay_at_venue") @map("pay_mode")
  /// requested | confirmed | completed | cancelled | rejected
  status         String   @default("requested")
  contactName    String   @map("contact_name")
  contactPhone   String   @map("contact_phone")
  notes          String?
  idempotencyKey String?  @map("idempotency_key")
  requestFingerprint String? @map("request_fingerprint")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  events CommerceBookingEvent[]

  @@unique([userId, idempotencyKey])
  @@index([partnerId, serviceId, startsAt])
  @@index([partnerId, resourceId, startsAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("commerce_bookings")
}

model CommerceBookingEvent {
  id         String          @id @default(uuid())
  bookingId  String          @map("booking_id")
  booking    CommerceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorType  String          @map("actor_type")
  actorId    String?         @map("actor_id")
  fromStatus String?         @map("from_status")
  toStatus   String?         @map("to_status")
  note       String?
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([bookingId, createdAt])
  @@map("commerce_booking_events")
}
