# AT-4R / Local QA — Fashion Knowledge Mode B
# Copy to mira-api/.env.qa and fill secrets locally.
# NEVER commit .env.qa
#
#   cp .env.qa.example .env.qa
#   # edit LLM_API_KEY only on this machine
#   source scripts/at4r-export-qa-env.sh
#   npm run start:dev
#
# Then live proof:
#   AT4_LIVE_PROVIDER=1 npm run test:at4

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Required for live Mode B ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=45000
FASHION_KNOWLEDGE_LLM_TIMEOUT_MS=15000
FASHION_KNOWLEDGE_LLM_MAX_OUTPUT_TOKENS=1200

# --- QA Fashion Knowledge flags (local only) ---
FASHION_KNOWLEDGE_ADVISOR_INTEGRATION_ENABLED=true
FASHION_KNOWLEDGE_LLM_ENABLED=true
FASHION_KNOWLEDGE_TELEMETRY_ENABLED=false
FASHION_KNOWLEDGE_REGISTRY_ENABLED=false
FASHION_KNOWLEDGE_ACCESSORIES_ENABLED=false
FASHION_KNOWLEDGE_FORM_SILHOUETTE_ENABLED=false
FASHION_KNOWLEDGE_CULTURAL_CONTEXT_ENABLED=false
FASHION_KNOWLEDGE_LEGACY_MCE_FASHION_ALLOWED=false

# --- Local auth (approved by FirebaseAuthGuard for non-production) ---
AUTH_SKIP=true

# --- CORS for local Flutter / website tooling ---
WEBSITE_CORS_ORIGINS=*

# DATABASE_URL — reuse values from your local .env (do not invent)
# DATABASE_URL=
