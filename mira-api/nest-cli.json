{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "vision/qel/fixtures/**/*", "watchAssets": true },
      {
        "include": "beauty-experience/capability/*.json",
        "watchAssets": true
      },
      {
        "include": "fashion-knowledge/assets/**/*",
        "watchAssets": true
      }
    ]
  }
}
