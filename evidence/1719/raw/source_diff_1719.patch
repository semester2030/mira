+  Future<int> _ensureProxy() async {
+    if (_proxy != null && _proxyPort != null) return _proxyPort!;
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    _proxy = server;
+    _proxyPort = server.port;
+    server.listen(_handleProxyRequest);
+    return server.port!;
+  }
