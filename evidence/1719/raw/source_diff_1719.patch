+  VideoPlayerController? _takePrepared(String assetPath) {
+    final id = _mediaIdOf(assetPath);
+    if (id == null) return null;
+    final c = _preparedByMediaId.remove(id);
+    _preparedOrder.remove(id);
+    return c;
+  }
