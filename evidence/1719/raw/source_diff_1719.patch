+      final range = req.headers.value(HttpHeaders.rangeHeader);
+      var start = 0;
+      var end = (total != null && total > 0 ? total : math.max(have, 1)) - 1;
+      if (range != null && range.startsWith('bytes=')) {
+        final spec = range.substring(6);
+        final parts = spec.split('-');
