+      final started = DateTime.now().toUtc();
+      int? firstByteMs;
+      var bytesFromDisk = 0;
+      var bytesFromNetwork = 0;
+      void publishStats({int? completeMs}) {
+        lastServeStats = DiscoverByteServeStats(
