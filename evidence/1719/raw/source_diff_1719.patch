+          await _streamRangeOnSocket(
+            socket: socket,
+            mediaId: mediaId,
+            origin: origin,
+            start: start,
+            end: end,
+            total: total,
+            have: have,
+            file: file,
+            isClientGone: () => clientGone,
+            markClientGone: () {
