+          bytesFromDisk: bytesFromDisk,
+          bytesFromNetwork: bytesFromNetwork,
+          contentLength: total,
+          source: 'proxy_stream',
+          requestStart: start,
+          requestEnd: serveEnd,
+          firstByteMs: firstByteMs,
+          completeMs: completeMs,
