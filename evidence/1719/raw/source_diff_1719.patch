+    final port = await _ensureProxy();
+    final playUrl = Uri.parse('http://127.0.0.1:$port/play/$mediaId');
+    return DiscoverPlaySource.proxy(
+      playUrl,
+      mediaId: mediaId,
+      bytesOnDisk: have,
+      originUrl: url,
+    );
+  }
