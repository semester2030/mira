+      if (range != null && range.startsWith('bytes=')) {
+        final parts = range.substring(6).split('-');
+        start = int.tryParse(parts[0]) ?? 0;
+        if (parts.length > 1 && parts[1].isNotEmpty) {
+          end = int.tryParse(parts[1]) ?? end;
